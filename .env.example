# ==============================================================================
# AEGIS PAYMENT SWITCH: CONFIGURATION SPECIFICATION
# [HUMAN EDIT]: Configure your environment variables below
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# [HUMAN EDIT 1]: Solana RPC Endpoint (Mainnet or Devnet)
# Replace with your Helius, QuickNode, or Alchemy RPC for high-throughput production
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta

# [HUMAN EDIT 2]: Master Settlement Vault Wallet (SPL USDC Destination)
# This is your cold/warm treasury address receiving platform fees and aggregated settlements
MASTER_TREASURY_ADDRESS=2nNtE6uEJQjX5vN1cS1m4FBRDuxxqq2hwmtFqn92xkNd

# [HUMAN EDIT 3]: Token Mint (Default: Mainnet SPL USDC)
# Mainnet USDC: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Devnet USDC: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# [HUMAN EDIT 4]: Redis Connection (Idempotency and In-Flight Locks)
REDIS_URL=redis://127.0.0.1:6379
REDIS_IDEMPOTENCY_TTL_SECONDS=180

# [HUMAN EDIT 5]: PostgreSQL Database (Double-Entry Ledger & Merchant State)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/aegis_switch

# [HUMAN EDIT 6]: Webhook Signing Secret (HMAC-SHA256)
# Used to cryptographically sign outbound merchant callback notifications
WEBHOOK_SIGNING_SECRET=aegis_sec_live_replace_with_strong_random_secret_32_bytes
